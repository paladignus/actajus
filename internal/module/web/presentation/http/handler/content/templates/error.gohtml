{{define "content/error"}}
{{$data := .Data}}
<section class="error-view">
  <section class="error-card">
    <div class="error-card__art" aria-hidden="true">
      <span class="error-card__shape error-card__shape--one"></span>
      <span class="error-card__shape error-card__shape--two"></span>
      <span class="error-card__shape error-card__shape--three"></span>
    </div>

    <div class="error-card__hero">
      <p class="dashboard-hero__eyebrow">Actajus WEB</p>
      <nav class="error-card__breadcrumbs" aria-label="Breadcrumb">
        {{range $index, $item := index $data "Breadcrumbs"}}
          {{if gt $index 0}}<span class="error-card__breadcrumbs-separator">/</span>{{end}}
          <a class="error-card__breadcrumbs-link" href="{{index $item "Href"}}">{{index $item "Label"}}</a>
        {{end}}
      </nav>
      <div class="error-card__code">{{with index $data "Code"}}{{.}}{{else}}Erro{{end}}</div>
      <h1 class="error-card__title">{{with index $data "Message"}}{{.}}{{else}}Nao foi possivel concluir a navegacao solicitada.{{end}}</h1>
      <p class="error-card__summary">A navegacao foi interrompida antes de carregar a experiencia solicitada. Revise a rota ou volte para uma area conhecida do painel.</p>
    </div>

    <div class="error-card__meta">
      <div class="error-card__meta-item">
        <span class="error-card__meta-label">Rota</span>
        <code class="error-card__meta-value">{{with index $data "CurrentPath"}}{{.}}{{else}}/{{end}}</code>
      </div>
      <div class="error-card__meta-item">
        <span class="error-card__meta-label">Status</span>
        <span class="error-card__meta-value">{{with index $data "Code"}}{{.}}{{else}}Erro{{end}}</span>
      </div>
    </div>

    <div class="error-card__actions">
      <a class="button button--primary" href="{{with index $data "PrimaryHref"}}{{.}}{{else}}/{{end}}">{{with index $data "PrimaryLabel"}}{{.}}{{else}}Ir para o inicio{{end}}</a>
      <a class="button button--ghost" href="/">Pagina inicial</a>
      <button class="button button--ghost" type="button" onclick="history.back()">Voltar uma pagina</button>
    </div>

    <div class="error-card__search" data-error-route-search>
      <div>
        <strong class="error-card__shortcuts-title">Busca rapida de rota</strong>
        <p class="dashboard-panel__summary">Pesquise por uma area conhecida do sistema e navegue direto.</p>
      </div>
      <label class="form-field">
        <span>Buscar rota</span>
        <input type="search" name="route_search" placeholder="Ex.: companies, sessoes, roles" data-error-route-input>
      </label>
      <p class="error-card__search-hint">Atalhos: <kbd>/</kbd> para focar, <kbd>Ctrl</kbd> + <kbd>K</kbd> para abrir a busca, <kbd>Enter</kbd> para navegar.</p>
      <div class="error-card__route-results" data-error-route-results></div>
    </div>

    <div class="error-card__shortcuts">
      <strong class="error-card__shortcuts-title">Atalhos uteis</strong>
      <div class="error-card__shortcuts-grid">
        {{range index $data "Shortcuts"}}
        <a class="error-card__shortcut" href="{{index . "Href"}}">
          <span class="error-card__shortcut-label">{{index . "Label"}}</span>
          <span class="error-card__shortcut-href">{{index . "Href"}}</span>
        </a>
        {{end}}
      </div>
    </div>

    <div class="error-card__recent">
      <strong class="error-card__shortcuts-title">Ultimas areas visitadas</strong>
      <div class="error-card__shortcuts-grid" data-error-recent-routes></div>
    </div>

    <div class="error-card__tips">
      <strong class="error-card__tips-title">Sugestoes rapidas</strong>
      <ul class="error-card__tips-list">
        <li>Confirme se a URL digitada esta correta.</li>
        <li>Verifique se sua conta possui acesso a esse recurso.</li>
        <li>Use o painel principal para navegar por uma rota valida.</li>
      </ul>
    </div>
  </section>
</section>
{{end}}

{{define "pages/error"}}{{template "layout/error" .}}{{end}}

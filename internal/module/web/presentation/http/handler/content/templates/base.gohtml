</head>
<body class="dashboard-shell">
  {{template "dashboard/sidebar" .}}
  <div class="dashboard-shell__body">
    {{template "dashboard/topbar" .}}
    <main class="dashboard-shell__main">{{template "content/sessions" .}}</main>
  </div>
  <script>window.__ACTAJUS_BOOTSTRAP__={{.BootstrapJSON}};</script>
  {{range .Assets.Scripts}}<script type="module" src="{{.}}"></script>{{end}}
</body>
</html>
{{end}}


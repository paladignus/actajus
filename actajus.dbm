<?xml version="1.0" encoding="UTF-8"?>
<!--
CAUTION: Do not modify this file unless you know what you are doing.
 Unexpected results may occur if the code is changed deliberately.
-->
<dbmodel pgmodeler-ver="1.2.1" use-changelog="false" max-obj-count="4"
	 gen-disabled-objs-code="false" show-sys-schemas-rects="true"
	 last-position="-180,0" last-zoom="1" scene-rect="-180,-12.4274,1945.01,1089.23"
	 default-schema="public" default-owner="postgres"
	 layers="Default layer"
	 active-layers="0"
	 layer-name-colors="#000000"
	 layer-rect-colors="#b4b4b4"
	 show-layer-names="false" show-layer-rects="false">
<database name="actajus" is-template="false" allow-conns="true" append-at-eod="true">
	<appended-sql> <![CDATA[CREATE EXTENSION IF NOT EXISTS pgcrypto;
ALTER DATABASE protus SET datestyle TO "ISO, DMY";]]> </appended-sql>
</database>

<schema name="public" layers="0" fill-color="#e1e1e1" name-color="#000000" sql-disabled="true">
</schema>

<table name="people" layers="0" collapse-mode="2" max-obj-count="8" z-value="0">
	<schema name="public"/>
	<role name="postgres"/>
	<position x="520" y="100"/>
	<column name="idpeople" not-null="true" default-value="uuidv7()">
		<type name="uuid" length="0"/>
	</column>
	<column name="first_name" not-null="true">
		<type name="text" length="0"/>
	</column>
	<column name="last_name" not-null="true">
		<type name="text" length="0"/>
	</column>
	<column name="birthday">
		<type name="date" length="0"/>
	</column>
	<column name="id_mother">
		<type name="uuid" length="0"/>
	</column>
	<column name="id_father">
		<type name="uuid" length="0"/>
	</column>
	<constraint name="people_pk" type="pk-constr" table="public.people">
		<columns names="idpeople" ref-type="src-columns"/>
	</constraint>

	<customidxs object-type="column">
		<object name="id_gender" index="6"/>
	</customidxs>
	<customidxs object-type="constraint">
		<object name="gender_fk" index="3"/>
	</customidxs></table>

<table name="gender" layers="0" collapse-mode="2" max-obj-count="2" z-value="0">
	<schema name="public"/>
	<role name="postgres"/>
	<position x="0" y="320"/>
	<column name="idgender" not-null="true"
	 identity-type="ALWAYS">
		<type name="smallint" length="0"/>
	</column>
	<column name="name" not-null="true">
		<type name="text" length="0"/>
	</column>
	<constraint name="gender_pkey" type="pk-constr" table="public.gender">
		<columns names="idgender" ref-type="src-columns"/>
	</constraint>
</table>

<table name="documents" layers="0" collapse-mode="2" max-obj-count="4" z-value="0">
	<schema name="public"/>
	<role name="postgres"/>
	<position x="0" y="20"/>
	<column name="iddocuments" not-null="true" default-value="uuidv7()">
		<type name="uuid" length="0"/>
	</column>
	<column name="cpf">
		<type name="text" length="0"/>
	</column>
	<constraint name="documents_pk" type="pk-constr" table="public.documents">
		<columns names="iddocuments" ref-type="src-columns"/>
	</constraint>
	<constraint name="cpf_uq" type="uq-constr" table="public.documents">
		<columns names="cpf" ref-type="src-columns"/>
	</constraint>

	<customidxs object-type="column">
		<object name="id_people" index="2"/>
	</customidxs>
	<customidxs object-type="constraint">
		<object name="documents_uq" index="3"/>
		<object name="people_fk" index="2"/>
	</customidxs></table>

<table name="accounts" layers="0" collapse-mode="2" max-obj-count="4" z-value="0">
	<schema name="public"/>
	<role name="postgres"/>
	<position x="1060" y="100"/>
	<column name="idaccounts" not-null="true" default-value="uuidv7()">
		<type name="uuid" length="0"/>
	</column>
	<column name="password" not-null="true">
		<type name="text" length="0"/>
	</column>
	<column name="avatar">
		<type name="text" length="0"/>
	</column>
	<constraint name="accounts_pk" type="pk-constr" table="public.accounts">
		<columns names="idaccounts" ref-type="src-columns"/>
	</constraint>
</table>

<relationship name="gender_has_many_people" type="rel1n" layers="0"
	 src-col-pattern="id_{st}"
	 pk-pattern="{dt}_pk" uq-pattern="{dt}_uq"
	 src-fk-pattern="{st}_fk"
	 fk-idx-pattern="{st}_idx"
	 custom-color="#fa0816"
	 src-table="public.gender"
	 dst-table="public.people"
	 src-required="true" dst-required="false"/>

<relationship name="accounts_has_one_people" type="rel11" layers="0"
	 src-col-pattern="id_{st}"
	 pk-pattern="{dt}_pk" uq-pattern="{dt}_uq"
	 src-fk-pattern="{st}_fk"
	 fk-idx-pattern="{st}_idx"
	 custom-color="#ccde04"
	 src-table="public.people"
	 dst-table="public.accounts"
	 src-required="true" dst-required="false"/>

<relationship name="documents_has_one_people" type="rel11" layers="0"
	 src-col-pattern="id_{st}"
	 pk-pattern="{dt}_pk" uq-pattern="{dt}_uq"
	 src-fk-pattern="{st}_fk"
	 fk-idx-pattern="{st}_idx"
	 custom-color="#594b5e"
	 src-table="public.people"
	 dst-table="public.documents"
	 src-required="true" dst-required="false"/>

<constraint name="mother_fk" type="fk-constr" comparison-type="MATCH FULL"
	 upd-action="CASCADE" del-action="SET NULL" ref-table="public.people" table="public.people">
	<columns names="id_mother" ref-type="src-columns"/>
	<columns names="idpeople" ref-type="dst-columns"/>
</constraint>

<constraint name="father_fk" type="fk-constr" comparison-type="MATCH FULL"
	 upd-action="CASCADE" del-action="SET NULL" ref-table="public.people" table="public.people">
	<columns names="id_father" ref-type="src-columns"/>
	<columns names="idpeople" ref-type="dst-columns"/>
</constraint>

<relationship name="son_has_a_mother" type="relfk" layers="0"
	 custom-color="#852883"
	 src-table="public.people"
	 dst-table="public.people" reference-fk="mother_fk"
	 src-required="false" dst-required="false">
	<line>
		<position x="768.633" y="199.508"/>
	<position x="768.633" y="78"/>
	<position x="671.089" y="78"/>
	</line>
	<label ref-type="name-label">
		<position x="0" y="0"/>
	</label>
</relationship>

<relationship name="son_has_a_father" type="relfk" layers="0"
	 custom-color="#852883"
	 src-table="public.people"
	 dst-table="public.people" reference-fk="father_fk"
	 src-required="false" dst-required="false">
	<line>
		<position x="786.763" y="217.639"/>
	<position x="786.763" y="59.8694"/>
	<position x="652.958" y="59.8694"/>
	</line>
	<label ref-type="name-label">
		<position x="0" y="0"/>
	</label>
</relationship>

</dbmodel>

  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "title": "HTTP Request Rate",
      "type": "timeseries",
      "id": 1,
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "targets": [
        {
          "expr": "rate(http_requests_total[5m])",
          "legendFormat": "{{method}} {{path}} {{status}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "yellow", "value": 100},
              {"color": "red", "value": 500}
            ]
          }
        }
      }
    },
    {
      "title": "HTTP Request Duration (p95)",
      "type": "timeseries",
      "id": 2,
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "targets": [
        {
          "expr": "histogram_quantile(0.95, rate(http_request_duration_seconds_bucket[5m]))",
          "legendFormat": "{{method}} {{path}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "yellow", "value": 0.5},
              {"color": "red", "value": 1}
            ]
          }
        }
      }
    },
    {
      "title": "Authentication Success vs Failure",
      "type": "timeseries",
      "id": 3,
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
      "targets": [
        {
          "expr": "rate(auth_success_total[5m])",
          "legendFormat": "Success",
          "refId": "A"
        },
        {
          "expr": "rate(auth_failures_total[5m])",
          "legendFormat": "Failure",
          "refId": "B"
        }
      ]
    },
    {
      "title": "Database Connection Pool",
      "type": "timeseries",
      "id": 4,
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
      "targets": [
        {
          "expr": "database_pool_total_conns",
          "legendFormat": "Total",
          "refId": "A"
        },
        {
          "expr": "database_pool_acquired_conns",
          "legendFormat": "Acquired (In Use)",
          "refId": "B"
        },
        {
          "expr": "database_pool_idle_conns",
          "legendFormat": "Idle",
          "refId": "C"
        },
        {
          "expr": "database_pool_max_conns",
          "legendFormat": "Max Allowed",
          "refId": "D"
        }
      ]
    },
    {
      "title": "Go Runtime - Goroutines & Memory",
      "type": "timeseries",
      "id": 5,
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 16},
      "targets": [
        {
          "expr": "go_goroutines",
          "legendFormat": "Goroutines",
          "refId": "A"
        },
        {
          "expr": "go_memory_alloc_bytes",
          "legendFormat": "Memory Alloc (bytes)",
          "refId": "B"
        }
      ]
    },
    {
      "title": "Password Reset Requests",
      "type": "stat",
      "id": 6,
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 16},
      "targets": [
        {
          "expr": "rate(password_reset_requests_total[1h])",
          "legendFormat": "Per Hour",
          "refId": "A"
        }
      ]
    }
  ],

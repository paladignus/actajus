{
  "annotations": {
    "list": []
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "title": "Authentication Success Rate",
      "type": "gauge",
      "id": 1,
      "gridPos": {"h": 8, "w": 8, "x": 0, "y": 0},
      "targets": [
        {
          "expr": "rate(auth_success_total[5m]) / (rate(auth_success_total[5m]) + rate(auth_failures_total[5m])) * 100",
          "legendFormat": "Success Rate %",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "red", "value": 0},
              {"color": "yellow", "value": 80},
              {"color": "green", "value": 95}
            ]
          }
        }
      }
    },
    {
      "title": "Emails Sent",
      "type": "timeseries",
      "id": 2,
      "gridPos": {"h": 8, "w": 8, "x": 8, "y": 0},
      "targets": [
        {
          "expr": "rate(emails_sent_total[5m])",
          "legendFormat": "{{template}}",
          "refId": "A"
        }
      ]
    },
    {
      "title": "gRPC/Connect Request Rate",
      "type": "timeseries",
      "id": 3,
      "gridPos": {"h": 8, "w": 8, "x": 16, "y": 0},
      "targets": [
        {
          "expr": "rate(http_requests_total{method=\"POST\"}[5m])",
          "legendFormat": "{{path}} {{status}}",
          "refId": "A"
        }
      ]
    },
    {
      "title": "Health Check Status",
      "type": "stat",
      "id": 4,
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
      "targets": [
        {
          "expr": "probe_success{job=\"actajus-health\"}",
          "legendFormat": "Health Check",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {"options": {"0": {"text": "DOWN"}}, "type": "value"},
            {"options": {"1": {"text": "UP"}}, "type": "value"}
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "red", "value": null},
              {"color": "green", "value": 1}
            ]
          }
        }
      }
    },
    {
      "title": "Tracing - Jaeger Traces",
      "type": "stat",
      "id": 5,
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
      "description": "Check Jaeger UI for distributed traces",
      "targets": [
        {
          "expr": "rate(http_request_duration_seconds_count[5m])",
          "legendFormat": "Traces per second",
          "refId": "A"
        }
      ]
    }
  ],
  "schemaVersion": 39,
  "tags": ["actajus", "security", "identity"],
  "templating": {"list": []},
  "time": {"from": "now-6h", "to": "now"},
  "timepicker": {},
  "timezone": "browser",
  "title": "ActaJus - Identity & Security",
  "uid": "actajus-identity",
  "version": 1,
  "weekStart": ""
}

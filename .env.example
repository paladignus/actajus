# Exemplo de variáveis de ambiente
# Copie este arquivo para .env e preencha com os valores apropriados

# Configurações do banco de dados
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=sua_senha_segura
DB_NAME=sidof
DB_SSLMODE=disable

# Configurações do servidor
SERVER_PORT=8080
GRPC_PORT=50051
ENV=development

# Configurações JWT
ACCESS_SECRET=sua_chave_secreta_para_tokens_de_acesso
REFRESH_SECRET=sua_chave_secreta_para_tokens_de_refresh
RESET_SECRET=sua_chave_secreta_para_reset_de_senha
JWT_ISSUER=seu_dominio.com.br

# Configurações SMTP (para envio de emails)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seu_email@gmail.com
SMTP_PASS=sua_senha_de_aplicativo
SMTP_FROM="Nome <seu_email@gmail.com>"
PUBLIC_BASE_URL="http://localhost"

# Configurações NATS
NATS_SUBJECTS=events.>
NATS_URL=nats://localhost:4222
NATS_STREAM_NAME=EVENTS
NATS_CONSUMER_NAME=sidof-consumer
NATS_DURABLE_NAME=sidof-durable
NATS_REPLAY_POLICY=last
NATS_MAX_BYTES=1073741824
NATS_REPLICAS=1
NATS_MAX_DELIVER=3
NATS_MAX_ACK_PENDING=100

# Configurações de tracing (OpenTelemetry OTLP)
TRACING_SERVICE_NAME=actajus-api
TRACING_ENDPOINT_URL=http://localhost:4318/v1/traces
TRACING_INSECURE=true
TRACING_ENABLED=false

# Configurações Redis
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_PREFIX=actajus:
